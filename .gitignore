.env
.venv/
__pycache__/
.pytest_cache/
.DS_Store

# Claude Code. Worktrees, transcripts and personal overrides are machine-local
# and must never be committed — .claude/worktrees/ holds whole checkouts.
# Pattern is .claude/* rather than .claude/: git does not descend into an
# ignored directory, so the negation below would not work against .claude/.
.claude/*
!.claude/settings.json
