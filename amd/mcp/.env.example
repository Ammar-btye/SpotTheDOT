# Copy to amd/mcp/.env and fill in. Names follow docs/system2-rag-contract.md.
# In Docker, "localhost" is the container itself: use compose service names or host.docker.internal.

# Neon: use the read-only role (spot_mcp_reader) connection string. Pooled (-pooler) endpoints work.
DATABASE_URL=postgresql://mcp_user:password@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# Logs (app.mcp_tool_calls, app.model_calls). Defaults to DATABASE_URL.
# LOGS_DATABASE_URL=

# Embedding service (OpenAI-compatible /v1/embeddings; amd/embed)
EMBED_URL=http://localhost:8081
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_DIM=1024
# Qwen3 needs this instruction on queries ("\n" becomes a real newline). Set it empty for models without one.
EMBED_QUERY_PREFIX="Instruct: Given an operator question about a SPOT robot inspection, retrieve relevant inspection events, anomaly notes, operator notes, and Spot manual passages\nQuery:"

# Retrieval: drop matches below this cosine similarity (tune with app.get_mcp_tool_stats()).
MCP_MIN_SIMILARITY=0.40
MCP_PACKET_TOKEN_BUDGET=1500

# HTTP transport
# MCP_HOST is deliberately not set here (audit M7): the image sets MCP_HOST=0.0.0.0, and `--env-file` would
# override it, binding the container's loopback so the published port is dead (and Host: mcp:8090 gets a 421).
# Native runs (`python -m spot_mcp`) default to 127.0.0.1 without it.
# MCP_HOST=127.0.0.1
MCP_PORT=8090
# Shared secret for HTTP clients (Authorization: Bearer <token>). Strongly recommended off-localhost.
# MCP_AUTH_TOKEN=
# Set 0 to disable app.* logging.
MCP_LOG_CALLS=1
# Graph RAG (contract §7): the packet's graph section, and entry-node cutoffs for graph_neighborhood/search_graph.
# MCP_GRAPH_TOKEN_BUDGET=300
# MCP_GRAPH_MIN_SIMILARITY=      # default: MCP_MIN_SIMILARITY
# MCP_GRAPH_TEXT_MIN_SCORE=0.5

# client_example.py
LLM_URL=http://localhost:8080
LLM_MODEL=system2
# MCP_URL=http://localhost:8090/mcp
