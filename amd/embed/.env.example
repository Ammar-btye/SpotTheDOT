# Copy to amd/embed/.env (gitignored) and `set -a; . amd/embed/.env; set +a`. Contract: docs/system2-rag-contract.md §1, §6.

# Postgres: Neon (copy from the Neon console; sslmode=require) or the local Docker one (db/local_pgvector.sh).
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/spot
# DATABASE_URL=postgresql://neondb_owner:<password>@ep-xxxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
# LOGS_DATABASE_URL=            # raw.* + app.*; defaults to DATABASE_URL

# Embedding service (server.py, llama-server --embedding, TEI, ...). OpenAI-compatible /v1/embeddings.
EMBED_URL=http://localhost:8081
# Chosen in research/tech-embedding-model-amd-2026-10-10.md. Apache-2.0, 1024 dims.
EMBED_MODEL=Qwen/Qwen3-Embedding-0.6B
EMBED_DIM=1024
# Qwen3 query instruction. "\n" is turned into a real newline by client.py. Documents get no prefix.
EMBED_QUERY_PREFIX=Instruct: Given an operator question about a SPOT robot inspection, retrieve relevant inspection events, anomaly notes, operator notes, and Spot manual passages\nQuery:
EMBED_DOC_PREFIX=

# Fallback model (same 1024 width; switching = re-embed with `ingest.py --force`):
# EMBED_MODEL=Snowflake/snowflake-arctic-embed-l-v2.0
# EMBED_QUERY_PREFIX=query:

# server.py only (optional): EMBED_DEVICE=cuda|mps|cpu, EMBED_DTYPE=bfloat16|float32, EMBED_BATCH=32, HF_HOME=/models
